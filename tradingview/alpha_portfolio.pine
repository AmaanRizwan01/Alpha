//@version=5
indicator("Alpha - Volatility Breakout Benchmark Engine", shorttitle="Alpha Benchmark", overlay=true, precision=2)

// =============================================================================
// ALPHA - 4H VOLATILITY BREAKOUT BENCHMARK ENGINE (Pine Script v5)
// Reference strategy: 4h Donchian Breakout + Kaufman Efficiency Ratio (ER) Chop Gate
// + ATR Chandelier Trailing Stop + 200 EMA Regime Baseline
// =============================================================================

// --- Volatility Breakout Settings ---
grp_bo = "Volatility Breakout Settings"
bo_donchian_len = input.int(20, "Donchian Period", group=grp_bo)
bo_er_len       = input.int(24, "Efficiency Ratio (ER) Period", group=grp_bo)
bo_er_thresh    = input.float(0.30, "ER Anti-Chop Floor", step=0.01, group=grp_bo)
bo_atr_len      = input.int(14, "ATR Period", group=grp_bo)
bo_atr_min_pct  = input.float(0.009, "Min ATR Volatility Floor (0.90%)", step=0.001, group=grp_bo)
bo_ema_len      = input.int(200, "Regime Baseline EMA", group=grp_bo)
bo_trail_mult   = input.float(3.0, "Chandelier ATR Trailing Stop Multiplier", step=0.1, group=grp_bo)

// =============================================================================
// QUANTITATIVE CALCULATIONS
// =============================================================================

// ATR & Volatility Floor
atr_val = ta.atr(bo_atr_len)
atr_pct = atr_val / close

// Kaufman Efficiency Ratio (ER) Calculation
net_change = math.abs(close - close[bo_er_len])
path_sum = 0.0
for i = 0 to bo_er_len - 1
    path_sum += math.abs(close[i] - close[i + 1])
er_val = path_sum > 0 ? net_change / path_sum : 0.0

// Donchian Channels
donchian_high = ta.highest(high[1], bo_donchian_len)
donchian_low  = ta.lowest(low[1], bo_donchian_len)

// Trend Baseline
regime_ema = ta.ema(close, bo_ema_len)

// Trailing Stop State
var float trailing_stop = na

// =============================================================================
// SIGNALS & LOGIC
// =============================================================================

bo_filter_pass = (er_val >= bo_er_thresh) and (atr_pct >= bo_atr_min_pct) and (close > regime_ema)
buy_trigger = ta.crossover(close, donchian_high) and bo_filter_pass

if buy_trigger
    trailing_stop := high - (bo_trail_mult * atr_val)
else if not na(trailing_stop) and close > trailing_stop
    trailing_stop := math.max(trailing_stop, high - (bo_trail_mult * atr_val))
else if not na(trailing_stop) and close <= trailing_stop
    trailing_stop := na

exit_trigger = not na(trailing_stop[1]) and (close < trailing_stop[1])

// =============================================================================
// PLOTTING & VISUALIZATION
// =============================================================================

plot(donchian_high, "Donchian Upper (20)", color=color.new(color.teal, 30), linewidth=2)
plot(donchian_low,  "Donchian Lower (20)", color=color.new(color.maroon, 40), linewidth=1)
plot(regime_ema,    "200 EMA Baseline",    color=color.new(color.orange, 20), linewidth=2)
plot(trailing_stop, "ATR Chandelier Trail Stop", color=color.new(color.red, 10), linewidth=2, style=plot.style_linebr)

plotshape(buy_trigger, title="Buy Entry Signal", style=shape.triangleup,
     location=location.belowbar, color=color.green, size=size.normal, text="ALPHA BUY")

plotshape(exit_trigger, title="Exit / Stop Signal", style=shape.triangledown,
     location=location.abovebar, color=color.red, size=size.normal, text="EXIT")

// =============================================================================
// HUD DASHBOARD TABLE
// =============================================================================
var table hud = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Strategy", bgcolor=color.new(color.blue, 40), text_color=color.white)
    table.cell(hud, 1, 0, "VOLATILITY_BREAKOUT", bgcolor=color.new(color.blue, 40), text_color=color.white)

    table.cell(hud, 0, 1, "Chop Gate (ER 24)", bgcolor=color.new(color.black, 50), text_color=color.white)
    er_txt = str.tostring(er_val, "#.##") + (er_val >= bo_er_thresh ? " (PASS)" : " (CHOP)")
    table.cell(hud, 1, 1, er_txt, bgcolor=color.new(color.black, 50), text_color=er_val >= bo_er_thresh ? color.green : color.red)

    table.cell(hud, 0, 2, "Volatility (ATR%)", bgcolor=color.new(color.black, 50), text_color=color.white)
    atr_txt = str.tostring(atr_pct * 100, "#.##") + "%" + (atr_pct >= bo_atr_min_pct ? " (PASS)" : " (LOW)")
    table.cell(hud, 1, 2, atr_txt, bgcolor=color.new(color.black, 50), text_color=atr_pct >= bo_atr_min_pct ? color.green : color.red)

    table.cell(hud, 0, 3, "Regime Baseline", bgcolor=color.new(color.black, 50), text_color=color.white)
    reg_pass = (close > regime_ema)
    table.cell(hud, 1, 3, reg_pass ? "BULLISH (PASS)" : "BEARISH (ABSTAIN)", bgcolor=color.new(color.black, 50), text_color=reg_pass ? color.green : color.red)

// =============================================================================
// ALERT CONDITIONS
// =============================================================================
if buy_trigger
    alert('{"strategy": "VOLATILITY_BREAKOUT", "action": "BUY", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + '}', alert.freq_once_per_bar_close)

if exit_trigger
    alert('{"strategy": "VOLATILITY_BREAKOUT", "action": "CLOSE", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + '}', alert.freq_once_per_bar_close)

alertcondition(buy_trigger, title="Alpha Long Entry Alert", 
     message='{"action": "BUY", "ticker": "{{ticker}}", "price": {{close}}}')

alertcondition(exit_trigger, title="Alpha Stop/Exit Alert", 
     message='{"action": "CLOSE", "ticker": "{{ticker}}", "price": {{close}}}')
